# Terminal tools
brew "starship"                 # prompt
brew "zsh-autosuggestions"      # grey suggestions from history
brew "zsh-syntax-highlighting"  # colours commands as you type
brew "fzf"                      # fuzzy finder (Ctrl+R, Ctrl+T)
brew "zoxide"                   # `z` smart cd
brew "eza"                      # modern ls
brew "lazygit"                  # git UI in the terminal

# Font (used by VS Code; Ghostty ships JetBrains Mono built in)
cask "font-jetbrains-mono"
